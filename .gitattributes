# Normalize line endings to LF on commit, checkout as LF on all platforms
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf

# Binary files — no line-ending conversion
*.joblib binary
*.pkl    binary
*.pickle binary
*.db     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
