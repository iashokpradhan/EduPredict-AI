# EduPredict AI Configuration Example
# Copy to .env or set variables in your deployment environment.

# Database Configuration (PostgreSQL)
# Leave blank to use zero-config SQLite mode (data/edupredict.db).
EDUPREDICT_DATABASE_URL=postgresql://edupredict_user:edupredict_secret@localhost:5432/edupredict

# Optional Test Database URL for running integration tests against Postgres
EDUPREDICT_TEST_DATABASE_URL=

# Docker Compose Database Settings
POSTGRES_USER=edupredict_user
POSTGRES_PASSWORD=edupredict_secret
POSTGRES_DB=edupredict
